# Prefixed because these live in the shared ecosystem Doppler config next to
# other services' values (including the other Clerk tenant's CLERK_*). They
# are the names deejaytools-api reads, so one config feeds both through the
# cutover.

# Database. Plain postgresql:// URLs are fine; the app switches to asyncpg.
DEEJAYTOOLS_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/deejaytools
# OPS-002. Read only by scripts/apply_migrations.py, which runs before the
# app in the start command. Bind it to a role that owns the schema and keep
# DEEJAYTOOLS_DATABASE_URL's role without DDL. Unset locally: the runner
# falls back to DEEJAYTOOLS_DATABASE_URL and logs that the separation is not
# in effect.
DEEJAYTOOLS_DATABASE_URL_MIGRATIONS=

# Auth — the one trusted Clerk instance for this environment. Unset means
# every authenticated request is rejected. Also read by
# scripts/backfill_principals.py, which makes existing users principals of
# this issuer.
DEEJAYTOOLS_CLERK_ISSUER=https://clerk.deejaytools.com
DEEJAYTOOLS_CLERK_JWKS_URL=https://clerk.deejaytools.com/.well-known/jwks.json

# CORS — comma-separated.
DEEJAYTOOLS_CORS_ORIGINS=http://localhost:5173,https://deejaytools.com

# Unset resolves from RAILWAY_ENVIRONMENT_NAME, else local.
ENVIRONMENT=

# Sentry. Unset turns it off.
SENTRY_DSN_API_DEEJAYTOOLS=

# CD-036. Request metrics to CloudWatch, published in production only. Unset
# keys fall back to boto3's default credential chain.
AWS_REGION=us-east-1
DEEJAYTOOLS_METRICS_KEY_ID=
DEEJAYTOOLS_METRICS_SECRET=

# Feedback email (POST /v1/feedback) through Brevo. Unset: feedback is
# accepted and no email is sent. BREVO_API_KEY is the legacy name, read only
# when the prefixed one is unset or empty.
DEEJAYTOOLS_BREVO_API_KEY=
BREVO_API_KEY=

# Google Drive (deejaytools-api DRIVE.md). All three are required by every
# Drive call; with any missing, uploads and drive_jobs fail with "Google
# Drive environment variables are not configured". The key's literal \n
# sequences are turned into newlines. Scope used: drive.file only.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_DRIVE_PARENT_FOLDER_ID=

# Scheduler (session status advance, queue auto-fill, drive_jobs). Runs once
# at startup, then every TICK_INTERVAL_MS. DISABLE_SCHEDULER=1 turns it off:
# deploy with it set and turn it on only at cutover, never with
# deejaytools-api's scheduler also running (ADR-006 point 5). It is also off
# whenever ENVIRONMENT=test.
TICK_INTERVAL_MS=30000
DISABLE_SCHEDULER=1
# GET /internal/tick requires x-tick-secret to equal this. Unset: the route
# refuses every call (fails closed). An empty value is a set secret, so leave
# the line commented out rather than blank when there is no secret.
# TICK_SECRET=
